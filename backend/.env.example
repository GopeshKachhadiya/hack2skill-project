# ── Supply Chain Backend — Environment Variables ──────────────────────────────
# Copy this to .env and fill in your credentials

# Application
APP_NAME="Supply Chain Resilience API"
APP_VERSION="1.0.0"
DEBUG=false

# PostgreSQL (Railway / Render / local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/supply_chain

# Redis (Railway / local)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External API Keys
# OpenWeatherMap: https://openweathermap.org/api (free tier — 1000 calls/day)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Maps: https://console.cloud.google.com (free $200/month credits)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Prophet Model Storage
MODEL_STORAGE_PATH=./models
MODEL_RETRAIN_LOOKBACK_DAYS=90
FORECAST_HORIZON_HOURS=72

# Disruption Thresholds
DISRUPTION_ALERT_THRESHOLD=0.70
HIGH_RISK_THRESHOLD=0.50
MEDIUM_RISK_THRESHOLD=0.25

# Scheduling (in minutes/hours)
DATA_INGESTION_INTERVAL_MINUTES=15
PREDICTION_INTERVAL_MINUTES=15
METRICS_INTERVAL_HOURS=24
